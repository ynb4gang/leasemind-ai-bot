<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="dashboard-001-create-auth-and-qa" author="openai">
        <createTable tableName="app_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_app_user"/>
            </column>
            <column name="username" type="VARCHAR(120)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(255)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="app_role">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_app_role"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="app_user_role">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="app_user_role" columnNames="user_id, role_id" constraintName="pk_app_user_role"/>
        <addForeignKeyConstraint baseTableName="app_user_role" baseColumnNames="user_id"
                                 referencedTableName="app_user" referencedColumnNames="id"
                                 constraintName="fk_app_user_role_user" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="app_user_role" baseColumnNames="role_id"
                                 referencedTableName="app_role" referencedColumnNames="id"
                                 constraintName="fk_app_user_role_role" onDelete="CASCADE"/>

        <createTable tableName="qa_message">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_qa_message"/>
            </column>
            <column name="channel" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="chat_id" type="BIGINT"/>
            <column name="username" type="VARCHAR(120)"/>
            <column name="question_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="answer_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="sanitized_question" type="TEXT"/>
            <column name="sanitized_answer" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="app_role">
            <column name="code" value="ADMIN"/>
            <column name="name" value="Administrator"/>
        </insert>
        <insert tableName="app_role">
            <column name="code" value="ANALYST"/>
            <column name="name" value="Analyst"/>
        </insert>
        <insert tableName="app_role">
            <column name="code" value="VIEWER"/>
            <column name="name" value="Viewer"/>
        </insert>

        <insert tableName="app_user">
            <column name="id" valueNumeric="1"/>
            <column name="username" value="admin"/>
            <column name="password_hash" value="$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy"/>
            <column name="display_name" value="System Admin"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>

        <insert tableName="app_user_role">
            <column name="user_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="1"/>
        </insert>
        <insert tableName="app_user_role">
            <column name="user_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="2"/>
        </insert>
        <insert tableName="app_user_role">
            <column name="user_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="3"/>
        </insert>
    </changeSet>
</databaseChangeLog>
